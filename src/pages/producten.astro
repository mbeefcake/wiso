---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BookingForm from '@/components/BookingForm.astro';
import { COMPANY_INFO, RVS_KEERKLEP_PRODUCT } from '@/data/wisoData';
---

<BaseLayout
  title="Roestvrijstalen Keerklep Ø 125 mm | Producten | Wiso"
  description="Roestvrijstalen keerklep (diam. 125 mm) ter voorkoming van ratten in de woning via het riool. Duurzaam RVS ter vervanging van door ratten vernielde kunststof keerkleppen."
>
  <section class="border-b border-[#DCE2DE] bg-[#F6F7F5] py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Broodkruimelpad" class="text-xs font-medium text-[#4B575C]">
        <a href="/" class="hover:text-[#2E5A12]">Home</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="font-semibold text-[#0F171A]">Producten</span>
      </nav>

      <div class="mt-4 flex flex-col justify-between gap-4 md:flex-row md:items-end">
        <div>
          <span class="inline-block rounded bg-[#F1F7E4] px-3 py-1 font-mono text-xs font-bold uppercase tracking-wider text-[#2E5A12]">
            Product · Rattenwering in het riool
          </span>
          <h1 class="mt-2 font-heading text-3xl font-extrabold tracking-tight text-[#0F171A] sm:text-4xl">
            {RVS_KEERKLEP_PRODUCT.title} (Ø {RVS_KEERKLEP_PRODUCT.diameter})
          </h1>
        </div>
        <a
          href="#aanvragen"
          class="inline-flex min-h-[44px] items-center justify-center rounded bg-[#99CC33] px-5 py-2.5 text-sm font-bold text-[#0F171A] hover:bg-[#86B628]"
        >
          Keerklep + montage aanvragen ↓
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
        <!-- Productspecificaties & Galerij -->
        <div class="space-y-8 lg:col-span-6">
          <div class="rounded border border-[#DCE2DE] bg-white p-6 sm:p-8">
            <h2 class="font-heading text-2xl font-bold text-[#0F171A]">Productspecificaties</h2>
            <p class="mt-3 text-base leading-relaxed text-[#4B575C]">
              {RVS_KEERKLEP_PRODUCT.description}
            </p>

            <dl class="mt-6 divide-y divide-[#DCE2DE] rounded border border-[#DCE2DE]">
              <div class="grid grid-cols-3 gap-2 bg-[#F6F7F5] px-4 py-3 text-sm">
                <dt class="font-semibold text-[#4B575C]">Artikel</dt>
                <dd class="col-span-2 font-bold text-[#0F171A]">{RVS_KEERKLEP_PRODUCT.title}</dd>
              </div>
              <div class="grid grid-cols-3 gap-2 px-4 py-3 text-sm">
                <dt class="font-semibold text-[#4B575C]">Omschrijving</dt>
                <dd class="col-span-2 text-[#172024]">{RVS_KEERKLEP_PRODUCT.description}</dd>
              </div>
              <div class="grid grid-cols-3 gap-2 bg-[#F6F7F5] px-4 py-3 text-sm">
                <dt class="font-semibold text-[#4B575C]">Toepassing</dt>
                <dd class="col-span-2 text-[#172024]">{RVS_KEERKLEP_PRODUCT.replacementCaption}</dd>
              </div>
              <div class="grid grid-cols-3 gap-2 px-4 py-3 text-sm">
                <dt class="font-semibold text-[#4B575C]">Aansluitdiameter</dt>
                <dd class="col-span-2 font-mono font-bold text-[#2E5A12]">
                  Ø {RVS_KEERKLEP_PRODUCT.diameter} (ontstoppingsstuk)
                </dd>
              </div>
              <div class="grid grid-cols-3 gap-2 bg-[#F6F7F5] px-4 py-3 text-sm">
                <dt class="font-semibold text-[#4B575C]">Prijs</dt>
                <dd class="col-span-2 font-mono font-bold text-[#0F171A]">
                  {RVS_KEERKLEP_PRODUCT.price}
                </dd>
              </div>
            </dl>
          </div>

          <!-- 3 Originele foto's met originele bijschriften -->
          <div class="rounded border border-[#DCE2DE] bg-[#F6F7F5] p-6">
            <h2 class="font-mono text-xs font-bold uppercase tracking-wider text-[#2E5A12]">
              Praktijkvergelijking: Kunststof vs. Roestvrijstaal
            </h2>
            <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
              {
                RVS_KEERKLEP_PRODUCT.gallery.map((item) => (
                  <figure class="flex flex-col justify-between rounded border border-[#DCE2DE] bg-white p-3">
                    <div class="flex h-40 items-center justify-center overflow-hidden rounded border border-[#DCE2DE] bg-white p-1">
                      <img
                        src={item.url}
                        alt={item.alt}
                        width={item.width}
                        height={item.height}
                        class="max-h-full max-w-full object-contain"
                      />
                    </div>
                    <figcaption class="mt-2.5 text-xs leading-snug text-[#4B575C]">
                      {item.caption}
                    </figcaption>
                  </figure>
                ))
              }
            </div>
          </div>

          <div class="rounded border border-[#DCE2DE] bg-[#0F171A] p-6 text-white">
            <p class="font-mono text-xs font-bold uppercase tracking-wider text-[#99CC33]">
              Direct advies nodig?
            </p>
            <p class="mt-2 text-sm text-white/85">
              Wilt u weten of deze roestvrijstalen keerklep in uw bestaande ontstoppingsstuk past?
              Bel direct met <a href={COMPANY_INFO.phoneHref} class="font-mono font-bold text-[#99CC33] underline">{COMPANY_INFO.phoneDisplay}</a>.
            </p>
          </div>
        </div>

        <!-- Aanvraagformulier vooringevuld op RVS Keerklep -->
        <div id="aanvragen" class="lg:col-span-6">
          <BookingForm
            idPrefix="product-booking"
            selectedService="rvs-keerklep"
            heading="RVS Keerklep (Ø 125 mm) aanvragen"
            subheading="Vraag een vrijblijvende prijsopgave aan voor levering en vakkundige montage."
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
