---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { COMPANY_INFO, WISO_SERVICES } from '@/data/wisoData';

const categories = [
  { id: 'ontstoppen', title: 'Ontstoppen & Reinigen' },
  { id: 'inspectie', title: 'Inspectie & Detectie' },
  { id: 'reparatie', title: 'Reparatie & Preventief Onderhoud' },
] as const;
---

<BaseLayout
  title="Diensten | Wiso Allround Ontstoppingsbedrijf"
  description="Overzicht van alle 9 riooldiensten van Wiso: ontstopping (32–250 mm), reparatie en aanleg met 5 jaar garantie, rook- en cameradetectie, vetputten, dakgoten en kruipruimtes."
>
  <section class="border-b border-[#DCE2DE] bg-[#F6F7F5] py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Broodkruimelpad" class="text-xs font-medium text-[#4B575C]">
        <a href="/" class="hover:text-[#2E5A12]">Home</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="font-semibold text-[#0F171A]">Diensten</span>
      </nav>

      <div class="mt-4 grid grid-cols-1 items-center gap-8 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h1 class="font-heading text-3xl font-extrabold tracking-tight text-[#0F171A] sm:text-4xl">
            Alle riool- &amp; reinigingsdiensten
          </h1>
          <p class="mt-3 text-base leading-relaxed text-[#4B575C] sm:text-lg">
            Onze goed opgeleide, vakbekwame medewerkers zijn uitgerust met hypermoderne,
            geavanceerde apparatuur en gereedschappen. Kies hieronder een dienst voor uitgebreide
            informatie, technische mogelijkheden en directe aanvraag.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href={COMPANY_INFO.phoneHref}
              class="inline-flex items-center rounded bg-[#99CC33] px-5 py-2.5 text-sm font-bold text-[#0F171A] hover:bg-[#86B628]"
            >
              Direct bellen: {COMPANY_INFO.phoneDisplay}
            </a>
            <a
              href="/contact#aanvragen"
              class="inline-flex items-center rounded border border-[#0F171A] bg-white px-5 py-2.5 text-sm font-bold text-[#0F171A] hover:bg-[#0F171A] hover:text-white"
            >
              Offerte aanvragen
            </a>
          </div>
        </div>

        <div class="flex flex-wrap gap-3 lg:col-span-5 lg:justify-end">
          <figure class="rounded border border-[#DCE2DE] bg-white p-2 shadow-sm">
            <img
              src="https://www.wiso.nl/images/busje.jpg"
              alt="Servicewagen van Wiso Allround ontstoppingsbedrijf"
              width="200"
              height="132"
              class="h-[132px] w-[200px] rounded-sm object-cover"
            />
            <figcaption class="mt-1.5 text-center font-mono text-[11px] text-[#4B575C]">
              Servicewagen
            </figcaption>
          </figure>
          <figure class="rounded border border-[#DCE2DE] bg-white p-2 shadow-sm">
            <img
              src="https://www.wiso.nl/images/vetput-busjes.jpg"
              alt="Groene WISO servicewagens op locatie"
              width="200"
              height="150"
              class="h-[132px] w-[176px] rounded-sm object-cover"
            />
            <figcaption class="mt-1.5 text-center font-mono text-[11px] text-[#4B575C]">
              Inzet op locatie
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-16">
    <div class="mx-auto max-w-7xl space-y-14 px-4 sm:px-6 lg:px-8">
      {
        categories.map((cat) => {
          const items = WISO_SERVICES.filter((s) => s.category === cat.id);
          return (
            <div>
              <div class="border-b border-[#DCE2DE] pb-3">
                <h2 class="font-heading text-2xl font-extrabold text-[#0F171A]">{cat.title}</h2>
              </div>

              <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
                {items.map((service) => (
                  <article class="flex flex-col justify-between rounded border border-[#DCE2DE] bg-white p-6 transition-colors hover:border-[#2E5A12]/60">
                    <div>
                      <div class="flex items-start justify-between gap-3">
                        <div>
                          <span class="font-mono text-xs font-bold text-[#2E5A12]">
                            Dienst {service.number}
                          </span>
                          <h3 class="mt-1 font-heading text-xl font-bold text-[#0F171A]">
                            <a href={`/diensten/${service.slug}`} class="hover:text-[#2E5A12]">
                              {service.title}
                            </a>
                          </h3>
                        </div>
                        {service.images[0] ? (
                          <img
                            src={service.images[0].url}
                            alt={service.images[0].alt}
                            width={service.images[0].width}
                            height={service.images[0].height}
                            loading="lazy"
                            class="h-16 w-20 shrink-0 rounded border border-[#DCE2DE] object-cover"
                          />
                        ) : null}
                      </div>

                      <p class="mt-3 text-sm leading-relaxed text-[#4B575C]">{service.summary}</p>

                      <ul class="wiso-square-list mt-4 space-y-1.5 border-t border-[#DCE2DE] pt-3 text-xs font-medium text-[#172024]">
                        {service.bullets.map((b) => <li>{b}</li>)}
                      </ul>
                    </div>

                    <div class="mt-6 flex items-center justify-between border-t border-[#DCE2DE] pt-4">
                      <a
                        href={`/diensten/${service.slug}`}
                        class="text-sm font-bold text-[#2E5A12] hover:text-[#0F171A]"
                      >
                        Volledige informatie →
                      </a>
                      <a
                        href={`/contact?dienst=${service.id}#aanvragen`}
                        class="rounded bg-[#0F171A] px-3 py-1.5 text-xs font-bold text-white hover:bg-[#1E2629]"
                      >
                        Aanvragen
                      </a>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
