---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BookingForm from '@/components/BookingForm.astro';
import {
  COMPANY_INFO,
  GRES_VS_PVC,
  RVS_KEERKLEP_PRODUCT,
  WISO_SERVICES,
  type WisoService,
} from '@/data/wisoData';

export function getStaticPaths() {
  return WISO_SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: WisoService;
}

const { service } = Astro.props;
---

<BaseLayout
  title={`${service.title} | Wiso Allround Ontstoppingsbedrijf`}
  description={service.metaDescription}
>
  <!-- Paginaheader -->
  <section class="border-b border-[#DCE2DE] bg-[#F6F7F5] py-10 sm:py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Broodkruimelpad" class="text-xs font-medium text-[#4B575C]">
        <a href="/" class="hover:text-[#2E5A12]">Home</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <a href="/diensten" class="hover:text-[#2E5A12]">Diensten</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="font-semibold text-[#0F171A]">{service.title}</span>
      </nav>

      <div class="mt-4 flex flex-col justify-between gap-4 md:flex-row md:items-end">
        <div>
          <span class="inline-block rounded bg-[#F1F7E4] px-3 py-1 font-mono text-xs font-bold uppercase tracking-wider text-[#2E5A12]">
            Dienst {service.number} · {service.badge}
          </span>
          <h1 class="mt-2 font-heading text-3xl font-extrabold tracking-tight text-[#0F171A] sm:text-4xl">
            {service.title}
          </h1>
        </div>

        <div class="flex flex-wrap gap-3">
          <a
            href={COMPANY_INFO.phoneHref}
            class="inline-flex min-h-[44px] items-center rounded border border-[#DCE2DE] bg-white px-4 py-2 font-mono text-sm font-bold text-[#0F171A] hover:border-[#2E5A12]"
          >
            Bel {COMPANY_INFO.phoneDisplay}
          </a>
          <a
            href="#aanvragen"
            class="inline-flex min-h-[44px] items-center rounded bg-[#99CC33] px-5 py-2 text-sm font-bold text-[#0F171A] hover:bg-[#86B628]"
          >
            {service.ctaLabel} ↓
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2-Koloms Vaklayout: Linker Zijmenu + Rechter Inhoudskolom -->
  <section class="bg-white py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
        <!-- Zijbalk: Diensten navigatie + Spoed & Garantiekaart -->
        <aside class="space-y-6 lg:col-span-4">
          <nav
            aria-label="Alle diensten van Wiso"
            class="rounded border border-[#DCE2DE] bg-[#F6F7F5] p-5"
          >
            <h2 class="font-mono text-xs font-bold uppercase tracking-wider text-[#2E5A12]">
              Diensten overzicht
            </h2>
            <ul class="mt-3 space-y-1">
              {
                WISO_SERVICES.map((item) => {
                  const isActive = item.slug === service.slug;
                  return (
                    <li>
                      <a
                        href={`/diensten/${item.slug}`}
                        aria-current={isActive ? 'page' : undefined}
                        class:list={[
                          'flex items-center justify-between rounded px-3 py-2 text-sm transition-colors',
                          isActive
                            ? 'bg-[#0F171A] font-bold text-[#99CC33]'
                            : 'font-medium text-[#172024] hover:bg-white hover:text-[#2E5A12]',
                        ]}
                      >
                        <span class="flex items-center gap-2.5">
                          <span
                            class:list={[
                              'inline-block h-2 w-2 rounded-full',
                              isActive ? 'bg-[#99CC33]' : 'border border-[#4B575C]',
                            ]}
                            aria-hidden="true"
                          />
                          <span>{item.title}</span>
                        </span>
                        <span class="font-mono text-[11px] opacity-65">{item.number}</span>
                      </a>
                    </li>
                  );
                })
              }
            </ul>

            <div class="mt-4 border-t border-[#DCE2DE] pt-3">
              <a
                href="/producten"
                class="flex items-center justify-between rounded px-3 py-2 text-sm font-semibold text-[#2E5A12] hover:bg-white"
              >
                <span>{RVS_KEERKLEP_PRODUCT.title} (Ø {RVS_KEERKLEP_PRODUCT.diameter})</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </nav>

          <!-- Direct contact kader -->
          <div class="rounded border border-[#DCE2DE] bg-[#0F171A] p-6 text-white">
            <p class="font-mono text-xs font-bold uppercase tracking-wider text-[#99CC33]">
              Direct contact opnemen
            </p>
            <h2 class="mt-2 font-heading text-xl font-bold">
              Advies of hulp nodig bij {service.shortTitle.toLowerCase()}?
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-white/75">
              Bel direct voor snel overleg of vraag vrijblijvend een vaste prijsopgave aan via
              het formulier.
            </p>
            <div class="mt-5 space-y-2.5">
              <a
                href={COMPANY_INFO.phoneHref}
                class="flex min-h-[44px] w-full items-center justify-center rounded bg-[#99CC33] px-4 py-2.5 font-mono text-sm font-bold text-[#0F171A] hover:bg-[#86B628]"
              >
                Bel {COMPANY_INFO.phoneDisplay}
              </a>
              <a
                href={`mailto:${COMPANY_INFO.email}`}
                class="flex min-h-[44px] w-full items-center justify-center rounded border border-white/25 px-4 py-2.5 text-sm font-semibold text-white hover:bg-white/10"
              >
                {COMPANY_INFO.email}
              </a>
            </div>
          </div>
        </aside>

        <!-- Hoofdkolom: Volledige dienst-informatie + Specificaties + Foto's + Boekingsformulier -->
        <div class="space-y-8 lg:col-span-8">
          <div class="rounded border border-[#DCE2DE] bg-white p-6 sm:p-8">
            <h2 class="font-heading text-2xl font-bold text-[#0F171A]">
              Werkwijze &amp; omschrijving
            </h2>

            <div class="mt-4 space-y-4 text-base leading-relaxed text-[#172024]">
              {service.paragraphs.map((p) => <p>{p}</p>)}
            </div>

            {
              service.bullets.length > 0 ? (
                <div class="mt-6 rounded border border-[#DCE2DE] bg-[#F6F7F5] p-5">
                  {service.bulletLeadIn ? (
                    <p class="mb-3 text-sm font-bold text-[#0F171A]">{service.bulletLeadIn}</p>
                  ) : null}
                  <ul class="wiso-square-list space-y-2 text-sm font-medium text-[#172024]">
                    {service.bullets.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                </div>
              ) : null
            }

            <!-- Technische Specificatietabel -->
            <div class="mt-6">
              <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-[#2E5A12]">
                Technische specificaties
              </h3>
              <dl class="mt-2.5 divide-y divide-[#DCE2DE] rounded border border-[#DCE2DE] bg-white">
                {
                  service.specs.map((spec) => (
                    <div class="grid grid-cols-1 gap-1 px-4 py-3 sm:grid-cols-3">
                      <dt class="text-sm font-medium text-[#4B575C]">{spec.label}</dt>
                      <dd class="font-mono text-sm font-bold text-[#0F171A] sm:col-span-2">
                        {spec.value}
                      </dd>
                    </div>
                  ))
                }
              </dl>
            </div>

            <!-- Extra Gres vs PVC tabel bij Rioolreparatie -->
            {
              service.id === 'rioolreparatie' ? (
                <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
                  <div class="rounded border border-red-200 bg-red-50/40 p-5">
                    <h3 class="font-heading text-base font-bold text-[#0F171A]">
                      {GRES_VS_PVC.gresTitle}
                    </h3>
                    <ul class="mt-3 space-y-2 text-sm text-[#4B575C]">
                      {GRES_VS_PVC.gresPoints.map((pt) => (
                        <li class="flex items-start gap-2">
                          <span class="font-bold text-red-700" aria-hidden="true">✕</span>
                          <span>{pt}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div class="rounded border border-[#2E5A12]/40 bg-[#F1F7E4]/60 p-5">
                    <h3 class="font-heading text-base font-bold text-[#0F171A]">
                      {GRES_VS_PVC.pvcTitle}
                    </h3>
                    <ul class="wiso-square-list mt-3 space-y-2 text-sm font-medium text-[#172024]">
                      {GRES_VS_PVC.pvcPoints.map((pt) => <li>{pt}</li>)}
                    </ul>
                  </div>
                </div>
              ) : null
            }

            <!-- Originele praktijkfoto's scherp op natuurlijke afmetingen -->
            {
              service.images.length > 0 ? (
                <div class="mt-8 border-t border-[#DCE2DE] pt-6">
                  <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-[#4B575C]">
                    Praktijkbeeldmateriaal
                  </h3>
                  <div class="mt-3 flex flex-wrap gap-4">
                    {service.images.map((img) => (
                      <figure class="rounded border border-[#DCE2DE] bg-[#F6F7F5] p-2.5">
                        <img
                          src={img.url}
                          alt={img.alt}
                          width={img.width}
                          height={img.height}
                          class="h-[150px] w-[200px] rounded-sm object-cover"
                        />
                        {img.caption ? (
                          <figcaption class="mt-2 max-w-[200px] text-xs font-medium text-[#4B575C]">
                            {img.caption}
                          </figcaption>
                        ) : null}
                      </figure>
                    ))}
                  </div>
                </div>
              ) : null
            }
          </div>

          <!-- Vooringevuld aanvraagformulier voor deze specifieke dienst -->
          <div id="aanvragen">
            <BookingForm
              idPrefix={`service-${service.id}`}
              selectedService={service.id}
              heading={`${service.title} aanvragen`}
              subheading={`Vraag direct ${service.title.toLowerCase()} aan of ontvang een kosteloze, vrijblijvende prijsopgave vooraf.`}
            />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
