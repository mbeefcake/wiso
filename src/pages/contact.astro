---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BookingForm from '@/components/BookingForm.astro';
import ServiceAreaLookup from '@/components/ServiceAreaLookup.astro';
import { COMPANY_INFO } from '@/data/wisoData';
---

<BaseLayout
  title="Contact & Werkgebied | Wiso Allround Ontstoppingsbedrijf"
  description="Neem contact op met Wiso Allround ontstoppingsbedrijf, Markslagweg 1, 7481 RE Haaksbergen. Telefoon (053) 4356824, e-mail robert@hubertmail.nl."
>
  <section class="border-b border-[#DCE2DE] bg-[#F6F7F5] py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Broodkruimelpad" class="text-xs font-medium text-[#4B575C]">
        <a href="/" class="hover:text-[#2E5A12]">Home</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="font-semibold text-[#0F171A]">Contact &amp; Werkgebied</span>
      </nav>

      <h1 class="mt-4 font-heading text-3xl font-extrabold tracking-tight text-[#0F171A] sm:text-4xl">
        Contact &amp; direct een dienst aanvragen
      </h1>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-[#4B575C] sm:text-lg">
        Bel ons rechtstreeks voor snelle hulp of vul het formulier in voor een vrijblijvend advies
        en vaste prijsopgave vooraf.
      </p>
    </div>
  </section>

  <!-- Bedrijfsgegevens + Formulier -->
  <section id="aanvragen" class="bg-white py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-start">
        <div class="space-y-6 lg:col-span-5">
          <div class="rounded border border-[#DCE2DE] bg-[#F6F7F5] p-6 sm:p-8">
            <span class="font-mono text-xs font-bold uppercase tracking-wider text-[#2E5A12]">
              Bedrijfsgegevens
            </span>
            <h2 class="mt-2 font-heading text-2xl font-bold text-[#0F171A]">
              {COMPANY_INFO.name}
            </h2>

            <dl class="mt-6 space-y-4 border-t border-[#DCE2DE] pt-5 text-sm">
              <div>
                <dt class="font-semibold text-[#4B575C]">Bezoekadres</dt>
                <dd class="mt-1 font-medium text-[#0F171A]">
                  {COMPANY_INFO.street}
                  <br />
                  {COMPANY_INFO.postalCode} {COMPANY_INFO.city}
                </dd>
              </div>

              <div>
                <dt class="font-semibold text-[#4B575C]">Telefoonnummer</dt>
                <dd class="mt-1">
                  <a
                    href={COMPANY_INFO.phoneHref}
                    class="font-mono text-lg font-bold text-[#0F171A] underline decoration-[#99CC33] decoration-2 underline-offset-4 hover:text-[#2E5A12]"
                  >
                    {COMPANY_INFO.phoneDisplay}
                  </a>
                </dd>
              </div>

              <div>
                <dt class="font-semibold text-[#4B575C]">E-mailadres</dt>
                <dd class="mt-1">
                  <a
                    href={`mailto:${COMPANY_INFO.email}`}
                    class="font-semibold text-[#0F171A] underline decoration-[#DCE2DE] underline-offset-4 hover:text-[#2E5A12]"
                  >
                    {COMPANY_INFO.email}
                  </a>
                </dd>
              </div>
            </dl>

            <div class="mt-6 border-t border-[#DCE2DE] pt-5 text-xs leading-relaxed text-[#4B575C]">
              <p>
                <strong class="text-[#0F171A]">Vaste prijsafspraak &amp; 5 jaar garantie:</strong>{' '}
                Al onze adviezen en aanbiedingen zijn geheel kosteloos en vrijblijvend. Geen
                bijkomende kosten achteraf.
              </p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <BookingForm idPrefix="contact-booking" />
        </div>
      </div>
    </div>
  </section>

  <ServiceAreaLookup bookingHref="#aanvragen" />
</BaseLayout>
