---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://www.wiso.nl');
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : null}
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="dns-prefetch" href="https://www.wiso.nl" />
    <link rel="preconnect" href="https://www.wiso.nl" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Plumber",
        "name": "Wiso Allround ontstoppingsbedrijf",
        "alternateName": "Allround ontstoppingsbedrijf Wiso",
        "url": "https://www.wiso.nl/",
        "telephone": "+31534356824",
        "email": "robert@hubertmail.nl",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Markslagweg 1",
          "postalCode": "7481 RE",
          "addressLocality": "Haaksbergen",
          "addressCountry": "NL"
        },
        "areaServed": [
          "Twente",
          "Achterhoek",
          "Haaksbergen",
          "Enschede",
          "Hengelo",
          "Almelo",
          "Lochem",
          "Groenlo",
          "Gronau",
          "Nordhorn"
        ],
        "description": "Allround ontstoppingsbedrijf voor rioolreiniging, ontstopping (32-250 mm), rioolreparatie en -aanleg met 5 jaar garantie, stankdetectie, camera-inspectie, onderhoudscontracten, septic tank en vetputonderhoud, dakgootreiniging, kruipruimte-inspectie, leidingdetectie en RVS keerkleppen."
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-white text-[#172024] antialiased selection:bg-[#99CC33]/35 selection:text-[#0F171A]">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
